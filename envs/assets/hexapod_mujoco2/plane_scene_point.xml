  <mujoco model="hexapod_scene">

    <!-- 引入你的六足机器人 -->
    <include file="hexapod.xml"/>

    <asset>
      <texture type="2d"
              name="ground_tex"
              builtin="checker"
              rgb1="0.2 0.3 0.4"
              rgb2="0.1 0.2 0.3"
              width="512"
              height="512"/>
      <material name="ground_mat"
                texture="ground_tex"
                texrepeat="5 5"
                reflectance="0.2"/>
    </asset>

    <worldbody>
      <!-- 地面 -->
      <geom name="floor"
            type="plane"
            size="10 10 1"
            material="ground_mat"
            friction="2.0 0.05 0.02"  
            rgba="0.2 0.3 0.4 1"
            contype="1"
            conaffinity="63"/>

      <body name="target_marker" mocap="true" pos="0 0 0">
      <geom type="sphere"
          size="0.05"
          rgba="1 0 0 1"
          contype="0"
          conaffinity="0"/>
      </body>


      <!-- 光源 -->
      <light pos="0 0 2"
            dir="0 0 -1"
            directional="true"/>
    </worldbody>

  </mujoco>

